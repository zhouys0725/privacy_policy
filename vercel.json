{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/photo-director/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; style-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "zhonglihu.cn"
        }
      ],
      "destination": "/home.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.zhonglihu.cn"
        }
      ],
      "destination": "/home.html"
    },
    {
      "source": "/",
      "destination": "/yuno/privacy.html"
    },
    {
      "source": "/privacy",
      "destination": "/yuno/privacy.html"
    },
    {
      "source": "/privacy-en",
      "destination": "/yuno/privacy-en.html"
    },
    {
      "source": "/support",
      "destination": "/yuno/support.html"
    },
    {
      "source": "/support-en",
      "destination": "/yuno/support-en.html"
    },
    {
      "source": "/terms",
      "destination": "/yuno/terms.html"
    },
    {
      "source": "/terms-en",
      "destination": "/yuno/terms-en.html"
    },
    {
      "source": "/privacy.html",
      "destination": "/yuno/privacy.html"
    },
    {
      "source": "/privacy-en.html",
      "destination": "/yuno/privacy-en.html"
    },
    {
      "source": "/support.html",
      "destination": "/yuno/support.html"
    },
    {
      "source": "/support-en.html",
      "destination": "/yuno/support-en.html"
    },
    {
      "source": "/terms.html",
      "destination": "/yuno/terms.html"
    },
    {
      "source": "/terms-en.html",
      "destination": "/yuno/terms-en.html"
    }
  ]
}
